# Copy to .env and edit.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/stock_analyst

# Required, min 32 chars. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Local http development only. Leave true (the default) in production over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:5173

# --- Market data (all optional) ---
# SEC EDGAR asks every client to identify itself. Put YOUR name and email to enable official
# US fundamentals; leave empty to use Yahoo Finance fundamentals instead.
SEC_USER_AGENT=
# Where downloaded datasets and the trained sentiment model live (default: backend/data)
# DATA_DIR=
