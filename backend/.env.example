# Copy to .env and edit.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/stock_analyst

# Required, min 32 chars. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# Local http development only. Leave true (the default) in production over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

CORS_ORIGINS=http://localhost:5173

# --- Market data (all optional) ---
# SEC EDGAR asks every client to identify itself. Put YOUR name and email to enable official
# US fundamentals; leave empty to use Yahoo Finance fundamentals instead.
SEC_USER_AGENT=
# Where downloaded datasets and the trained sentiment model live (default: backend/data)
# DATA_DIR=

# ---- Social sign-in (optional). Leave a provider blank to keep its button disabled. ----
# Address you open in the browser; redirect URI to register = PUBLIC_URL/api/auth/oauth/<provider>/callback
PUBLIC_URL=http://localhost:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
X_CLIENT_ID=
X_CLIENT_SECRET=
# Apple needs an HTTPS public domain and a paid Apple Developer account
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
