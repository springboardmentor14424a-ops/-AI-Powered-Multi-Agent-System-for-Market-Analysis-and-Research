# ==============================================================================
# MULTI-AGENT STOCK RESEARCH ANALYST - ROOT ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/stock_research_db

# Security & Authentication
SECRET_KEY=generate-a-secure-random-32-byte-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Environment Mode
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173

# Market Defaults
DEFAULT_MARKET=NASDAQ
DEFAULT_ANALYSIS_PERIOD=1 Year

