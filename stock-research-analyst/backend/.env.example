# Copy this file to .env and fill in real values. NEVER commit .env.
DATABASE_URL=postgresql+psycopg2://stock_user:stock_pass@localhost:5432/stock_research
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Set to true when served over HTTPS (production)
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
# Module 1 placeholder workflow delay (seconds). Replaced by real agents in Module 2.
RESEARCH_STUB_DELAY_SECONDS=3
# Stock search via Yahoo Finance (yfinance). Set false to use only the built-in ticker list.
YAHOO_SEARCH_ENABLED=true
