# ==============================================================================
# FRONTEND CONFIGURATION TEMPLATE (.env.example)
# Rename this file to .env and adjust values for your environment.
# ==============================================================================

# Google OAuth 2.0 Client ID (Required for Google Single Sign-On)
# Obtain from Google Cloud Console > APIs & Services > Credentials
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Backend API Base URL
# Default '/api' is automatically proxied by Vite dev server to http://127.0.0.1:8000
VITE_API_URL=/api
